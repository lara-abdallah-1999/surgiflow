{
  "name": "surgery-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copilot:build": "node scripts/build-copilot-server.mjs",
    "copilot:dev": "node scripts/build-copilot-server.mjs && node --env-file-if-exists=.env server/index.mjs",
    "test:copilot": "node scripts/build-copilot-server.mjs && node --test tests/*.test.mjs",
